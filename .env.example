NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgres://app:app@localhost:5432/viewings

# Redis
REDIS_URL=redis://localhost:6379

# Auth: use a long random value in production (openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN=15m

# Cache TTL for public listing reads, seconds
CACHE_TTL_SECONDS=30
